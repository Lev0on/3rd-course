<Window x:Class="Практика_13_14.AddNewTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Практика_13_14"
        mc:Ignorable="d"
        Title="AddNewTaskWindow" Height="450" Width="800">
    <StackPanel>
        <Label Content="Добавление новой задачи" 
               HorizontalAlignment="Center" 
               FontSize="35"/>

        <TextBlock Text="Категория:" 
                   HorizontalAlignment="Center" 
                   FontSize="25"/>
        <ComboBox Width="250" 
                  Height="30" 
                  FontSize="20" 
                  x:Name="CBCategory">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding CategoryName}"/>
                        <Image Source="{Binding ImageCategory}" 
                               Width="32" 
                               Margin="5 0 0 0"/>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="Задача:" 
                   FontSize="25" 
                   HorizontalAlignment="Center" 
                   Margin="0 15 0 0"/>
        <RichTextBox Width="350" 
                     Height="250" 
                     FontSize="20" 
                     x:Name="TaskDescription"/>

        <Button Content="Сохранить" 
                IsDefault="True" 
                Click="SaveTask" 
                Width="250" 
                Margin="0 25 0 0"/>
        <Button Content="Отмена" 
                Background="DarkGray" 
                IsCancel="True" 
                Width="250"/>
    </StackPanel>
</Window>
