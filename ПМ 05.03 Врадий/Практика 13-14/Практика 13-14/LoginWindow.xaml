<Window x:Class="Практика_13_14.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Практика_13_14"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Логин:" Margin="0,0,0,5"/>
        <TextBox Grid.Row="1" x:Name="LoginBox" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="2" Text="Пароль:" Margin="0,0,0,5"/>
        <PasswordBox Grid.Row="3" x:Name="PasswordBox" Margin="0,0,0,15"/>

        <Button Grid.Row="4" Content="Войти" Click="LoginButton_Click" Height="30"/>
        <TextBlock x:Name="MessageLabel" Grid.Row="5" Foreground="Red" TextAlignment="Center" Margin="0,10,0,0"/>
    </Grid>
</Window>
