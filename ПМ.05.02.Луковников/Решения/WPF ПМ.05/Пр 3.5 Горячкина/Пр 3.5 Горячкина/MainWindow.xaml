<Window x:Class="Пр_3._5_Горячкина.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Пр_3._5_Горячкина"
        mc:Ignorable="d"
        Title="MainWindow" Height="650" Width="1000">
    <StackPanel>
        <ListView x:Name="ItemsLV" SelectionChanged="SelectItem">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical" Width="300" Height="300">
                        <TextBlock Text="{Binding NameItem,StringFormat= Название: {0}}" FontSize="24"></TextBlock>
                        <TextBlock Text="{Binding PriceItem,StringFormat= Цена: {0}}" FontSize="20"></TextBlock>
                        <Image Source="{Binding PathImage}" Width="150" Height="150"></Image>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel></WrapPanel>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
        </ListView>

        <StackPanel Margin="15 15 0 0" HorizontalAlignment="Left">
            <Label Content="Создание нового товара:" FontSize="20"></Label>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Название товара:" FontSize="15" Margin="5 0 0 0" Width="110"></TextBlock>
                <TextBox FontSize="15" Width="150" Margin="5 0 0 0" x:Name="NameTB"></TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Цена товара:" FontSize="15" Margin="5 0 0 0" Width="110"></TextBlock>
                <TextBox FontSize="15" Width="150" Margin="5 0 0 0" x:Name="PriceTB"></TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5" Width="300">
                <TextBlock Text="Картинка:" FontSize="15" Margin="5 0 0 0" Width="110"></TextBlock>
                <TextBox FontSize="15" Width="150" Margin="5 0 0 0" x:Name="TBPathImage"></TextBox>
            </StackPanel>
            <Button Width="250" Height="28" Content="Добавить" Click="AddNewItemClick"></Button>
        </StackPanel>
        <StackPanel Margin="15 15 0 0" HorizontalAlignment="Left">
            <TextBlock Width="250" TextWrapping="Wrap"
                       Text="Для удаления выберите товар, а потом нажмите на кнопку"
                       FontSize="18">
            </TextBlock>
            <StackPanel>
                <TextBlock x:Name="SelectItemForDelete" Text="Вы пока ничего не выбрали" FontSize="18"></TextBlock>
            </StackPanel>
            <Button Content="Удалить" FontSize="18" Click="DeleteItemClick"></Button>
        </StackPanel>

        <StackPanel Margin="15 15 0 0" HorizontalAlignment="Left">
            <Label Content="Редактирование товара:" FontSize="20"></Label>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Название товара:" FontSize="15" Margin="5 0 0 0" Width="110"></TextBlock>
                <TextBox FontSize="15" Width="150" Margin="5 0 0 0" x:Name="EditNameTB"></TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Цена товара:" FontSize="15" Margin="5 0 0 0" Width="110"></TextBlock>
                <TextBox FontSize="15" Width="150" Margin="5 0 0 0" x:Name="EditPriceTB"></TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5" Width="300">
                <TextBlock Text="Картинка:" FontSize="15" Margin="5 0 0 0" Width="110"></TextBlock>
                <TextBox FontSize="15" Width="150" Margin="5 0 0 0" x:Name="EditTBPathImage"></TextBox>
            </StackPanel>
            <Button Width="250" Height="28" Content="Сохранить" Click="EditItemClick"></Button>
        </StackPanel>
    </StackPanel>
</Window>
