<Window x:Class="Пр_2_ListBox_Горячкина.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Пр_2_ListBox_Горячкина"
        mc:Ignorable="d"
        Title="ListBox2" Height="450" Width="800">
    <StackPanel>
        <Label Content="Пользователи системы" FontSize="20" HorizontalAlignment="Center"></Label>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Label Content="Поиск:" FontSize="18"></Label>
            <TextBox Width="250" x:Name="SearchText" TextChanged="SearchText_TextChanged"></TextBox>
        </StackPanel>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
            <Button Margin="5" Width="195" Height="25" Content="Сортировать по Алфавиту" Click="SortByAlf"></Button>
            <Button Width="195" Height="25" Content="Сортировать в обратном порядке" Click="SortDesc"></Button>
        </StackPanel>

        <ComboBox Width="250" Height="25" FontSize="15" Margin="5" x:Name="SortByLength" SelectionChanged="SortByLength_Selected"></ComboBox>
        
        <ListBox x:Name="UsersLB" Width="300"
         Height="250" Background="#FFF5F1F1"
         FontSize="20" Margin="15">
        </ListBox>
    </StackPanel>
</Window>
