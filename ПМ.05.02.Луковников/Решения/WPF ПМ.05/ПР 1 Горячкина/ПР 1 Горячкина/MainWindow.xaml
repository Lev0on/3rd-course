<Window x:Class="ПР_1_Горячкина.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ПР_1_Горячкина"
        mc:Ignorable="d"
        Title="ListBox.Работа с людьми" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center" Margin="10">
            <Label Content="Работа с ListBox" HorizontalAlignment="Center" FontSize="28"></Label>
            <Label x:Name="SelectName" Content="Вы пока никого не выбрали" FontSize="20" HorizontalAlignment="Center"></Label>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <ListBox x:Name="UsersLB" Width="300" Height="200" Background="#FFF5F1F1" FontSize="20" SelectionChanged="SelectedName" Margin="5"></ListBox>
            <Button x:Name="TransferButton" Content=">>" Click="TransferButton_Click" Width="50" Height="30" Margin="5"/>
            <ListBox x:Name="UsersNE" Width="300" Height="200" Background="#FFF5F1F1" FontSize="20" Margin="5"></ListBox>
        </StackPanel>
        <StackPanel Grid.Row="2"  Orientation="Vertical" HorizontalAlignment="Center" Margin="10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                    <TextBox Width="150" Height="25" Margin="5" x:Name="NameТВ"></TextBox>
                    <Button Width="150" Height="25" Content="Добавить новое имя" Click="AddNewUser"></Button>
                </StackPanel>
                <Button Width="250" Height="25" Content="Удалить выбранный элемент" Click="DeleteUser"></Button>
            </StackPanel>
    </Grid>
</Window>
