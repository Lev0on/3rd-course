<Window x:Class="ct.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ct"
        mc:Ignorable="d"
        Title="" Height="485" Width="922">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Левая панель навигации -->
            <ColumnDefinition Width="200"/>
            <!-- Основная рабочая область -->
            <ColumnDefinition Width="1000"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <!--Верхнее меню-->
        <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" FontSize="25" RenderTransformOrigin="0.538,0.461"><Run Text="                                "/><Run Language="ru-ru" Text="Система тестирования для курсового проекта"/></TextBlock>
        <!-- Левое меню -->
        <Border Grid.Column="0" Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" VerticalAlignment="Top" Margin="8,5,8,0" RenderTransformOrigin="0.505,0.271" Height="314">
            <StackPanel Height="203">
                <Button x:Name="BtnTests" Content="Тесты"  Click="NavButton_Click" Margin="15"/>
                <Button x:Name="BtnResults" Content="Результаты"  Click="NavButton_Click" Margin="15"/>
                <Button x:Name="BtnUsers" Content="Пользователи" Click="NavButton_Click" Margin="15"/>
            </StackPanel>
        </Border>

        <!-- Рабочая область -->
        <Border Grid.Column="1" Grid.Row="1" Padding="10" VerticalAlignment="Center" Height="414" Margin="0,0,280,0">
            <ScrollViewer Margin="0,0,-10,0">
                <ContentControl x:Name="MainContent">
                    <Frame x:Name="Frame" Height="388" Width="686" NavigationUIVisibility="Hidden">

                    </Frame>
                </ContentControl>
            </ScrollViewer>
        </Border>
    </Grid>

    <Window.Resources>
        <!-- Стиль для кнопок навигации -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#333"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8F0FE"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
</Window>
