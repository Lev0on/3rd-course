<Page x:Class="ct.TestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ct"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TestsPage">

    <Grid>
        <DataGrid x:Name="TestsDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  Margin="10" >
            <DataGrid.Columns>
                
                <DataGridTextColumn Header="Тема" 
                                    Binding="{Binding Theme}" 
                                    Width="150"/>
                <DataGridTextColumn Header="Дисциплина" 
                    Binding="{Binding Discipline}" 
                    Width="*"/>
                <DataGridTextColumn Header="Количество вопросов" 
                                    Binding="{Binding CountQuestion}" 
                                    Width="80"/>
                <DataGridTextColumn Header="Автор" 
                                    Binding="{Binding User.Name}" 
                                    Width="100"/>
                

                <!-- Кнопка пройти тест -->
                <DataGridTemplateColumn Header="Действия" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="📝 Пройти тест" 
                                    Padding="5"
                                    Margin="2"
                                    Background="#4CAF50"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="BtnTakeTest_Click"
                                    Tag="{Binding TestID}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>