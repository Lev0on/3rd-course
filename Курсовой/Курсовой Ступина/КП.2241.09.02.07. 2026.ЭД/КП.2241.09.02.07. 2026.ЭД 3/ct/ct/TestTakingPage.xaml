<Page x:Class="ct.TestTakingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ct"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TestTakingPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="TxtTestTitle" 
                       Text="Название теста" 
                       FontSize="24" 
                       FontWeight="Bold"/>
            <TextBlock x:Name="TxtTestInfo" 
                       Text="Дисциплина: " 
                       FontSize="14" 
                       Foreground="Gray"
                       Margin="0,5,0,0"/>
            <TextBlock Text="Введите ваши ответы на вопросы:" 
                       FontSize="14"
                       Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Список вопросов -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,0,0,20">
            <StackPanel x:Name="QuestionsPanel">
                <!-- Вопросы будут добавлены программно -->
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="Отмена" 
                    Width="100" 
                    Height="35"
                    Margin="5"
                    Click="BtnCancel_Click"/>
            <Button Content="Завершить тест" 
                    Width="150" 
                    Height="35"
                    Margin="5"
                    Background="#2196F3"
                    Foreground="White"
                    FontSize="14"
                    Click="BtnFinishTest_Click"/>
        </StackPanel>
    </Grid>
</Page>
