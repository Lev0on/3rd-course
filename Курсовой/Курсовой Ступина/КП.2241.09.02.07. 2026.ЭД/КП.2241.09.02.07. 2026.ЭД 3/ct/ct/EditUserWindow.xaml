<Window x:Class="ct.EditUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ct"
        mc:Ignorable="d"
        Title="EditUserWindow" Height="485" Width="800" MaxWidth="800" MaxHeight="485" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Информация о пользователе" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   Margin="0,0,0,15"/>

        <TextBlock Grid.Row="1" Text="Логин:" Margin="10,0,-10,10"/>
        <TextBox Grid.Row="1" x:Name="TxtLogin" Margin="11,17,10,24" Height="25" Grid.RowSpan="2"/>
        <TextBox Grid.Row="6" x:Name="TxtName" Margin="11,2,10,231"/>

        <TextBlock Grid.Row="3" Text="Фамилия:" Margin="11,35,-11,184" Grid.RowSpan="4"/>
        <TextBox Grid.Row="6" x:Name="TxtSurname" Margin="10,56,10,183" Height="25"/>

        <TextBlock Grid.Row="6" Text="Пароль:" Margin="11,85,-11,162"/>
        <PasswordBox Grid.Row="6" x:Name="TxtPassword" Margin="9,109,8,130" Height="25"/>


        <CheckBox Grid.Row="6" x:Name="ChkTeacher" 
                  Content="Учитель" 
                  Margin="9,152,-9,87" 
                  Height="25"/>

        <StackPanel Grid.Row="7" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,10,0,0">
            <Button Content="Отмена" 
                    Width="80" 
                    Margin="5" 
                    Click="BtnCancel_Click"/>
            <Button Content="Сохранить" 
                    Width="80" 
                    Margin="5" 
                    Click="BtnSave_Click"
                    IsDefault="True"/>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="Имя:" Margin="11,16,-11,4"/>
    </Grid>
</Window>
