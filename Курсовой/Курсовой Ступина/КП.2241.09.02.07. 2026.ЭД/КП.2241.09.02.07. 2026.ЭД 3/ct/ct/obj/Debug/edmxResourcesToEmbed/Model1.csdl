<?xml version="1.0" encoding="utf-8"?>
<Schema Namespace="CurTestsModel" Alias="Self" annotation:UseStrongSpatialTypes="false" xmlns:annotation="http://schemas.microsoft.com/ado/2009/02/edm/annotation" xmlns:customannotation="http://schemas.microsoft.com/ado/2013/11/edm/customannotation" xmlns="http://schemas.microsoft.com/ado/2009/11/edm">
  <EntityType Name="Question">
    <Key>
      <PropertyRef Name="QuestionID" />
    </Key>
    <Property Name="QuestionID" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="TestID" Type="Int32" Nullable="false" />
    <Property Name="TextQuestion" Type="String" MaxLength="1000" FixedLength="false" Unicode="true" Nullable="false" />
    <Property Name="Answer" Type="Int32" Nullable="false" />
    <NavigationProperty Name="Test" Relationship="Self.FK_Questions_Tests" FromRole="Questions" ToRole="Tests" />
    <NavigationProperty Name="Tryes" Relationship="CurTestsModel.FK_Tryes_Questions" FromRole="Question" ToRole="Trye" />
  </EntityType>
  <EntityType Name="sysdiagram">
    <Key>
      <PropertyRef Name="diagram_id" />
    </Key>
    <Property Name="name" Type="String" MaxLength="128" FixedLength="false" Unicode="true" Nullable="false" />
    <Property Name="principal_id" Type="Int32" Nullable="false" />
    <Property Name="diagram_id" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="version" Type="Int32" />
    <Property Name="definition" Type="Binary" MaxLength="Max" FixedLength="false" />
  </EntityType>
  <EntityType Name="Test">
    <Key>
      <PropertyRef Name="TestID" />
    </Key>
    <Property Name="TestID" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="CountQuestion" Type="Int32" Nullable="false" />
    <Property Name="AuthorID" Type="Int32" Nullable="false" />
    <Property Name="Discipline" Type="String" MaxLength="50" FixedLength="false" Unicode="true" Nullable="false" />
    <NavigationProperty Name="Questions" Relationship="Self.FK_Questions_Tests" FromRole="Tests" ToRole="Questions" />
    <NavigationProperty Name="User" Relationship="Self.FK_Tests_Users1" FromRole="Tests" ToRole="Users" />
    <NavigationProperty Name="Tryes" Relationship="Self.FK_Tryes_Tests" FromRole="Tests" ToRole="Tryes" />
    <Property Name="Theme" Type="String" MaxLength="50" FixedLength="false" Unicode="true" />
  </EntityType>
  <EntityType Name="Trye">
    <Key>
      <PropertyRef Name="TryID" />
    </Key>
    <Property Name="TryID" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="UID" Type="Int32" Nullable="false" />
    <Property Name="TestID" Type="Int32" Nullable="false" />
    <Property Name="QuestionID" Type="Int32" Nullable="false" />
    <Property Name="Answer" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="None" />
    <Property Name="WriteAnswer" Type="Boolean" Nullable="false" />
    <NavigationProperty Name="Test" Relationship="Self.FK_Tryes_Tests" FromRole="Tryes" ToRole="Tests" />
    <NavigationProperty Name="User" Relationship="Self.FK_Tryes_Users" FromRole="Tryes" ToRole="Users" />
    <NavigationProperty Name="Question" Relationship="CurTestsModel.FK_Tryes_Questions" FromRole="Trye" ToRole="Question" />
  </EntityType>
  <EntityType Name="User">
    <Key>
      <PropertyRef Name="UID" />
    </Key>
    <Property Name="UID" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="login" Type="String" MaxLength="50" FixedLength="false" Unicode="true" Nullable="false" />
    <Property Name="password" Type="String" MaxLength="50" FixedLength="false" Unicode="true" Nullable="false" />
    <Property Name="Name" Type="String" MaxLength="50" FixedLength="false" Unicode="true" Nullable="false" />
    <Property Name="Surname" Type="String" MaxLength="50" FixedLength="false" Unicode="true" Nullable="false" />
    <Property Name="Teacher" Type="Boolean" Nullable="false" />
    <NavigationProperty Name="Tests" Relationship="Self.FK_Tests_Users1" FromRole="Users" ToRole="Tests" />
    <NavigationProperty Name="Tryes" Relationship="Self.FK_Tryes_Users" FromRole="Users" ToRole="Tryes" />
  </EntityType>
  <Association Name="FK_Questions_Tests">
    <End Role="Tests" Type="Self.Test" Multiplicity="1" />
    <End Role="Questions" Type="Self.Question" Multiplicity="*" />
    <ReferentialConstraint>
      <Principal Role="Tests">
        <PropertyRef Name="TestID" />
      </Principal>
      <Dependent Role="Questions">
        <PropertyRef Name="TestID" />
      </Dependent>
    </ReferentialConstraint>
  </Association>
  <Association Name="FK_Tests_Users1">
    <End Role="Users" Type="Self.User" Multiplicity="1" />
    <End Role="Tests" Type="Self.Test" Multiplicity="*" />
    <ReferentialConstraint>
      <Principal Role="Users">
        <PropertyRef Name="UID" />
      </Principal>
      <Dependent Role="Tests">
        <PropertyRef Name="AuthorID" />
      </Dependent>
    </ReferentialConstraint>
  </Association>
  <Association Name="FK_Tryes_Tests">
    <End Role="Tests" Type="Self.Test" Multiplicity="1" />
    <End Role="Tryes" Type="Self.Trye" Multiplicity="*" />
    <ReferentialConstraint>
      <Principal Role="Tests">
        <PropertyRef Name="TestID" />
      </Principal>
