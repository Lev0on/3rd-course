        <PropertyRef Name="TestID" />
      </Dependent>
    </ReferentialConstraint>
  </Association>
  <Association Name="FK_Tryes_Users">
    <End Role="Users" Type="Self.User" Multiplicity="1" />
    <End Role="Tryes" Type="Self.Trye" Multiplicity="*" />
    <ReferentialConstraint>
      <Principal Role="Users">
        <PropertyRef Name="UID" />
      </Principal>
      <Dependent Role="Tryes">
        <PropertyRef Name="UID" />
      </Dependent>
    </ReferentialConstraint>
  </Association>
  <EntityContainer Name="CurTestsEntities" annotation:LazyLoadingEnabled="true">
    <EntitySet Name="Questions" EntityType="Self.Question" />
    <EntitySet Name="sysdiagrams" EntityType="Self.sysdiagram" />
    <EntitySet Name="Tests" EntityType="Self.Test" />
    <EntitySet Name="Tryes" EntityType="Self.Trye" />
    <EntitySet Name="Users" EntityType="Self.User" />
    <AssociationSet Name="FK_Questions_Tests" Association="Self.FK_Questions_Tests">
      <End Role="Tests" EntitySet="Tests" />
      <End Role="Questions" EntitySet="Questions" />
    </AssociationSet>
    <AssociationSet Name="FK_Tests_Users1" Association="Self.FK_Tests_Users1">
      <End Role="Users" EntitySet="Users" />
      <End Role="Tests" EntitySet="Tests" />
    </AssociationSet>
    <AssociationSet Name="FK_Tryes_Tests" Association="Self.FK_Tryes_Tests">
      <End Role="Tests" EntitySet="Tests" />
      <End Role="Tryes" EntitySet="Tryes" />
    </AssociationSet>
    <AssociationSet Name="FK_Tryes_Users" Association="Self.FK_Tryes_Users">
      <End Role="Users" EntitySet="Users" />
      <End Role="Tryes" EntitySet="Tryes" />
    </AssociationSet>
    <AssociationSet Name="FK_Tryes_Questions" Association="CurTestsModel.FK_Tryes_Questions">
      <End Role="Question" EntitySet="Questions" />
      <End Role="Trye" EntitySet="Tryes" />
    </AssociationSet>
  </EntityContainer>
  <Association Name="FK_Tryes_Questions">
    <End Type="CurTestsModel.Question" Role="Question" Multiplicity="1" />
    <End Type="CurTestsModel.Trye" Role="Trye" Multiplicity="*" />
    <ReferentialConstraint>
      <Principal Role="Question">
        <PropertyRef Name="QuestionID" />
      </Principal>
      <Dependent Role="Trye">
        <PropertyRef Name="QuestionID" />
      </Dependent>
